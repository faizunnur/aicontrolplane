{
  "name": "aicontrolplane",
  "version": "0.1.0",
  "private": true,
  "description": "Single control plane for AI agents scattered across ChatGPT, Claude, Grok and custom platforms.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/bootstrap.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/bootstrap.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "node --import tsx --test test/unit/*.test.ts",
    "test:e2e": "node --import tsx --test test/e2e/*.test.ts",
    "test:all": "npm test && npm run test:e2e",
    "login": "tsx scripts/login.ts",
    "push-state": "tsx scripts/push-state.ts",
    "connect": "tsx scripts/connect.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.278",
    "@anthropic-ai/sdk": "^0.127.0",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "http-proxy": "^1.18.1",
    "imapflow": "^1.0.200",
    "mailparser": "^3.7.4",
    "pg": "^8.23.0",
    "playwright": "1.63.0",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/http-proxy": "^1.17.16",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
