{
  "name": "aicontrolplane",
  "version": "0.1.0",
  "private": true,
  "description": "Single control plane for AI agents scattered across ChatGPT, Claude, Grok and custom platforms.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/bootstrap.ts",
    "dev:env": "tsx watch --env-file=.env src/bootstrap.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/bootstrap.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test test/unit/*.test.ts",
    "test:e2e": "node --import tsx --test test/e2e/*.test.ts",
    "test:all": "npm test && npm run test:e2e",
    "login": "tsx scripts/login.ts",
    "push-state": "tsx scripts/push-state.ts",
    "connect": "node public/connect.mjs",
    "connector": "tsx apps/connector/src/main.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.278",
    "@anthropic-ai/sdk": "^0.127.0",
    "@node-rs/argon2": "^2.2.1",
    "@types/compression": "^1.8.1",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^13.0.3",
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "http-proxy": "^1.18.1",
    "imapflow": "^1.0.200",
    "ioredis": "^6.0.0",
    "mailparser": "^3.7.4",
    "nodemailer": "^10.0.12",
    "pg": "^8.23.0",
    "pg-boss": "^12.35.0",
    "pino": "^10.3.1",
    "playwright": "1.63.0",
    "prom-client": "^15.1.3",
    "undici": "^8.11.2",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/http-proxy": "^1.17.16",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "autocannon": "^8.0.0",
    "eslint": "^10.11.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.1"
  }
}
