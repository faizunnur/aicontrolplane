# Paste into a SINGLE-service deployment (one container does everything, ROLE=all).
# Fill every <...>. Add Postgres and give the service 2 GB+ memory.
DATABASE_URL=${{Postgres.DATABASE_PRIVATE_URL}}
ACP_MASTER_KEY=<openssl rand -hex 32 - keep a copy somewhere safe>
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=30

# To open public sign-ups on a single-service deployment, ALL of these are needed too;
# without them the app runs exactly as before, as your private single-workspace install.
# BROWSER_FLEET=ephemeral
# SMTP_HOST=<smtp.your-provider.com>
# SMTP_PORT=587
# SMTP_USER=<smtp username>
# SMTP_PASS=<smtp password>
# SMTP_SECURE=false
# MAIL_FROM=<no-reply@your-domain.com>

# Optional: the command panel answers in Claude's words.
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# Optional alerts / email ingestion.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# ALERT_WEBHOOK_URL=
# IMAP_HOST=
# IMAP_USER=
# IMAP_PASS=

# LOG_LEVEL=info
