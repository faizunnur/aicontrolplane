# Paste into the api service: Variables -> Raw Editor. Fill every <...>.
ROLE=api
RAILWAY_DOCKERFILE_PATH=Dockerfile.api
DATABASE_URL=${{Postgres.DATABASE_PRIVATE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}?family=0
ACP_MASTER_KEY=<openssl rand -hex 32 - SAME value on api, worker and browser>
VNC_TARGET=http://browser.railway.internal:6080
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=15

# Sign-up emails (verification, password reset). Same values on the api only.
SMTP_HOST=<smtp.your-provider.com>
SMTP_PORT=587
SMTP_USER=<smtp username>
SMTP_PASS=<smtp password>
SMTP_SECURE=false
MAIL_FROM=<no-reply@your-domain.com>

# Optional: the command panel answers in Claude's words and routes between AIs.
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# Optional alerts (any that are set are used; also useful on worker and browser).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# ALERT_WEBHOOK_URL=

# Only if you prefer to pin the owner password / agent token on the server.
# ACP_ADMIN_TOKEN=
# ACP_INGEST_TOKEN=

# LOG_LEVEL=info
