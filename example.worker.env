# Paste into the worker service: Variables -> Raw Editor. Fill every <...>.
ROLE=worker
RAILWAY_DOCKERFILE_PATH=Dockerfile.api
DATABASE_URL=${{Postgres.DATABASE_PRIVATE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}?family=0
ACP_MASTER_KEY=<the SAME 64-character key as the api>
PUBLIC_URL=https://${{api.RAILWAY_PUBLIC_DOMAIN}}
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=30

# Multi-workspace sign-ups: set the SAME value as the api and browser services,
# so this worker schedules each workspace's provider sync separately.
BROWSER_FLEET=ephemeral

# Optional: read task notification emails (e.g. ChatGPT) into the registry.
# IMAP_HOST=
# IMAP_USER=
# IMAP_PASS=

# Optional: webhooks on your own LAN (production refuses private addresses by default).
# ACP_EGRESS_ALLOWLIST=

# Optional alerts.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# ALERT_WEBHOOK_URL=

# LOG_LEVEL=info
