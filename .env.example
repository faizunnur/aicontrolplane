# ---- Access (optional) ----
# Leave both empty and the app asks you to create a password on first visit and
# generates the agent token for you (shown under Settings › Developer).
# Set them here only if you prefer to manage them on the server.
ACP_ADMIN_TOKEN=
ACP_INGEST_TOKEN=

# ---- Keeping your data between deploys (pick one) ----
# 1. Postgres: add a database to the Railway project and reference its DATABASE_URL in this service.
#    Sign-ins, chats and settings are mirrored there and restored on boot. No volume needed.
DATABASE_URL=
# 2. Or attach a Railway volume mounted at /data (the image's default data folder).

# ---- Runtime ----
PORT=8080
# Local development only. Do NOT set this on Railway: the image already uses /data.
# DATA_DIR=./data
# false = real window (Xvfb in Docker, your desktop locally). true = no window, no VNC.
HEADLESS=false
# Set to false to run the API/dashboard only (no Chromium at all).
BROWSER_ENABLED=true
# chromium (default, bundled) or chrome if Google Chrome is installed. The Docker image installs Chrome and sets this.
BROWSER_CHANNEL=
# Exact browser binary to use instead (overrides BROWSER_CHANNEL).
BROWSER_EXECUTABLE=
# A desktop sign-in (plain browser window on the cloud display, for sites with a bot check) ends on its own after this.
DESKTOP_SIGNIN_TIMEOUT_MIN=10
# What the server prints to its console (what Railway's log shows): debug, info, warn or error. The Logs view in the
# app always keeps the last 2000 lines at every level, whatever this is set to, and can change it while running.
LOG_LEVEL=info
# Public URL of this deployment, used in alerts and in the "Connect from this computer" command. Learned from the
# first request when unset. Must be https:// for the connect helper to send a sign-in to it. Optional.
PUBLIC_URL=

# ---- Sync ----
SYNC_ENABLED=true
SYNC_INTERVAL_MIN=20
# Extra time to let single-page apps finish their XHR calls after load.
SYNC_SETTLE_MS=4000
# Comma separated platform ids to sync. Default: every platform with a tasksUrl.
SYNC_PLATFORMS=

# ---- Alerts (optional; any that are set will be used) ----
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_COOLDOWN_MIN=360

# ---- Email ingestion (optional). Reads notification emails, e.g. ChatGPT task results. ----
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
EMAIL_POLL_MIN=5
# Map sender domains to platform ids. Only matching senders are ingested unless EMAIL_INGEST_ALL=true.
EMAIL_SENDER_MAP={"openai.com":"chatgpt","tm.openai.com":"chatgpt","anthropic.com":"claude","claude.com":"claude","x.ai":"grok"}
EMAIL_INGEST_ALL=false

# ---- Messages / routing (optional) ----
# The router asks Claude which agent an instruction belongs to. Two ways to give it Claude:
#   1. Your Claude subscription: run "claude setup-token" on your laptop and paste the token here.
#      Uses the Claude Agent SDK. No API bill. For your own use only.
CLAUDE_CODE_OAUTH_TOKEN=
#   2. An Anthropic API key (pay per token).
ANTHROPIC_API_KEY=
# Which credential to use: auto (default: API key if set, else the subscription token), api, claude-code, none.
ROUTER_PROVIDER=auto
# Model id for the API provider. Leave empty for claude-code to use the subscription default.
ROUTER_MODEL=
# Wall-clock cap for one routing call, in milliseconds.
ROUTER_TIMEOUT_MS=60000
# Auto-assign when the router's confidence reaches this (0..1). Below it you get suggestions instead.
ROUTER_AUTO_THRESHOLD=0.75
# Force LLM routing on/off regardless of the credential (true/false). Default: on when a credential exists.
ROUTER_LLM=
